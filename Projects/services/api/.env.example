NODE_ENV=development
PORT=4000

# ─── Security (REQUIRED in production) ────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800

# ─── CORS (REQUIRED in production) ────────────────────────────────────────────
# Comma-separated, EXACT-match origins (scheme+host+port, NO trailing slash). In
# dev, all origins are allowed when this is empty; in production, empty = every
# cross-origin request is blocked, so this must be set.
# Production must include the deployed dashboard origin:
#   https://app.getsitesnapai.com
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8080,http://localhost:19006

# ─── Database (REQUIRED in production) ────────────────────────────────────────
# Omit for in-memory dev fallback (data resets on restart).
DATABASE_URL=
PG_SSL=
PG_SSL_REJECT_UNAUTHORIZED=true

# ─── Notifications (REQUIRED in production) ────────────────────────────────────
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@getsitesnapai.com
EMAIL_REPLY_TO=support@getsitesnapai.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── AI (optional) ─────────────────────────────────────────────────────────────
# Omit to use local diary generator (no AI cost).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Error tracking (optional) ─────────────────────────────────────────────────
# Create a project at sentry.io and paste the DSN here.
# Omit to disable crash reporting (errors are still logged to stdout).
SENTRY_DSN=

# ─── App config ────────────────────────────────────────────────────────────────
# Web reset page — used for email channel (opens in browser; supervisors use this)
# In production: https://app.getsitesnapai.com/reset-password
PASSWORD_RESET_WEB_URL=http://localhost:3001/reset-password
# Mobile deep-link reset — used for SMS channel (opens the app)
PASSWORD_RESET_URL=sitesnap://reset-password
INVITE_URL=sitesnap://invite
ACCOUNT_VERIFICATION_TTL_MS=600000

# ─── Rate limiting (optional — defaults shown) ─────────────────────────────────
# Redis backend (optional). Without it, limits are in-memory: they are NOT shared
# between instances and reset on every deploy — which means the 24-hour caps below
# are not really daily caps. That matters most for the per-phone OTP cap, whose job
# is to stop a real person's phone being used as an SMS target.
#
# The fallback is deliberate and stays: if Redis is configured but unreachable, the
# limiter counts in process memory rather than failing the request, because locking
# every user out of login is a worse outcome than imprecise counting. It is no longer
# SILENT about it — a degraded limiter logs at error, raises one Sentry event on the
# transition (not per request), and is reported on /health/ready as
# {"rateLimiter":{"backend":"memory","state":"degraded",...}}. Check that field before
# believing Redis is in use.
#
# Recommended instance config: maxmemory-policy=allkeys-lru (every key here has a TTL,
# so eviction under pressure loses the oldest counters rather than erroring), and disk
# persistence ON, so the 24h caps survive a restart.
#
# NOTE (Sept 2026): production is on Render Key Value's FREE tier, which has no disk
# persistence. Counters now survive API deploys — a real improvement — but they are
# lost on any Key Value restart, so the *_DAILY caps below are not true daily caps
# yet. See §11 of Projects/docs/SiteSnap-Release-Runbook.md.
# REDIS_URL=redis://localhost:6379

# --- Redis connect behaviour ------------------------------------------------
# These two shape what happens in the window between the process starting and the
# Redis socket being usable. Both have sane defaults; set them only if you have a
# measured reason.
#
# How long a Redis that is configured but not yet ready may fail QUIETLY before
# it is announced as a degradation. Boot is not an incident: without this window
# every deploy fired one Sentry degradation alert, which put a floor of 1 under
# degradationReports and made the field useless for spotting a real outage. The
# silence is bounded — if the socket never becomes ready, the degradation is
# announced once when this expires.
# RATE_LIMIT_REDIS_CONNECT_GRACE_MS=10000               # 10 s
#
# How long the FIRST rate-limited request waits for the handshake before giving
# up and counting in process memory. Deliberately much shorter than the grace
# window above, because this one sits in the critical path of a user's login.
# Without the wait, every request arriving during the handshake was counted in
# memory instead of Redis, so the counters were wrong by that many on every
# deploy. Raising it trades login latency for counter accuracy on exactly one
# request per process; lowering it does the reverse.
# RATE_LIMIT_REDIS_READY_TIMEOUT_MS=3000                # 3 s

# Login — per account (primary brute-force protection)
# RATE_LIMIT_LOGIN_PER_ACCOUNT=10
# RATE_LIMIT_LOGIN_PER_ACCOUNT_WINDOW_MS=900000        # 15 min

# Login — per IP (scanner/bot backstop; should be much higher than per-account)
# RATE_LIMIT_LOGIN_PER_IP=300
# RATE_LIMIT_LOGIN_PER_IP_WINDOW_MS=900000             # 15 min

# Registration initiate — per IP
# RATE_LIMIT_REGISTER_PER_IP=30
# RATE_LIMIT_REGISTER_PER_IP_WINDOW_MS=3600000         # 1 hr

# Registration verify — per IP
# RATE_LIMIT_REGISTER_VERIFY_PER_IP=60
# RATE_LIMIT_REGISTER_VERIFY_PER_IP_WINDOW_MS=600000   # 10 min

# OTP send — per-account burst (prevents an address being spammed with codes)
# RATE_LIMIT_OTP_SEND_PER_ACCOUNT=5
# RATE_LIMIT_OTP_SEND_PER_ACCOUNT_WINDOW_MS=900000     # 15 min

# OTP send — per-account daily ceiling
# RATE_LIMIT_OTP_SEND_PER_ACCOUNT_DAILY=20
# RATE_LIMIT_OTP_SEND_PER_ACCOUNT_DAILY_WINDOW_MS=86400000  # 24 hr

# OTP send — per IP (stops bots cycling through email addresses)
# RATE_LIMIT_OTP_SEND_PER_IP=20
# RATE_LIMIT_OTP_SEND_PER_IP_WINDOW_MS=3600000         # 1 hr

# OTP send — per PHONE burst. Keyed on the normalized phone number, checked at both
# registration stages: stage 1 peeks (so an exhausted number is turned away before any
# work is done) and stage 2 increments (because stage 2 is where the SMS is actually
# sent). Account limits key on EMAIL, so without this an attacker cycling throwaway
# addresses could aim unbounded SMS at one victim's real number.
# RATE_LIMIT_OTP_SEND_PER_PHONE=3
# RATE_LIMIT_OTP_SEND_PER_PHONE_WINDOW_MS=900000       # 15 min

# OTP send — per-phone daily ceiling (the cap that actually protects a victim's phone)
# RATE_LIMIT_OTP_SEND_PER_PHONE_DAILY=10
# RATE_LIMIT_OTP_SEND_PER_PHONE_DAILY_WINDOW_MS=86400000    # 24 hr

# OTP verify — max wrong-code attempts before the pending registration is invalidated
# RATE_LIMIT_OTP_VERIFY_MAX_ATTEMPTS=5

# Password reset send — per IP
# RATE_LIMIT_FORGOT_PASSWORD_PER_IP=8
# RATE_LIMIT_FORGOT_PASSWORD_PER_IP_WINDOW_MS=600000   # 10 min

# Password reset send — per IDENTIFIER (normalized email or phone). Checked BEFORE the
# account lookup, so it applies identically to registered and unregistered identifiers
# and cannot be used as an account-existence oracle. /auth/forgot-password accepts
# channel=sms, so per-IP alone left one account's phone reachable from any IP pool.
# RATE_LIMIT_FORGOT_PASSWORD_PER_IDENTIFIER=3
# RATE_LIMIT_FORGOT_PASSWORD_PER_IDENTIFIER_WINDOW_MS=900000     # 15 min

# RATE_LIMIT_FORGOT_PASSWORD_PER_IDENTIFIER_DAILY=10
# RATE_LIMIT_FORGOT_PASSWORD_PER_IDENTIFIER_DAILY_WINDOW_MS=86400000   # 24 hr

# Password reset confirm — per IP
# RATE_LIMIT_RESET_PASSWORD_PER_IP=12
# RATE_LIMIT_RESET_PASSWORD_PER_IP_WINDOW_MS=600000    # 10 min

# AI diary generation — per COMPANY. This endpoint spends OpenAI credit, and the spend
# is authenticated, so it is charged to the payer rather than to an IP. Sized so no
# legitimate crew meets it; the prepaid OpenAI balance is the real spend ceiling.
# RATE_LIMIT_GENERATE_DIARY_PER_COMPANY=30
# RATE_LIMIT_GENERATE_DIARY_PER_COMPANY_WINDOW_MS=3600000    # 1 hr

# Test bypass: set BOTH to allow tests to skip rate limits (never set in production)
# RATE_LIMIT_DISABLE=1  (only effective when NODE_ENV=test)

# ─── Media storage ─────────────────────────────────────────────────────────────
# "local" for dev disk (default), "s3" for production S3-compatible storage.
MEDIA_STORAGE_PROVIDER=local

# Generic S3-compatible (REQUIRED when MEDIA_STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# AWS S3 aliases
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 aliases
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

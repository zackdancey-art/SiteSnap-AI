{
  "name": "services-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf dist tsconfig.tsbuildinfo && pnpm run build && ./scripts/run-tests.sh memory",
    "test:redis": "pnpm run build && ./scripts/run-tests.sh redis",
    "test:db": "pnpm run build && ./scripts/run-tests.sh db",
    "test:openai": "pnpm run build && ./scripts/run-tests.sh openai",
    "load-test": "NODE_ENV=test RATE_LIMIT_DISABLE=1 ts-node-dev --transpile-only --exit-child load-test.ts",
    "teardown-loadtest": "ts-node-dev --transpile-only --exit-child teardown-loadtest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@sentry/node": "^10.51.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.22.0",
    "pg": "^8.20.0",
    "uuid": "^11.0.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/pg": "^8.18.0",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.5.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}

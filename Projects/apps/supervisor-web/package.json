    "react-dom": "^18.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0"
  }

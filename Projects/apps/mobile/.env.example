# Copy to .env for local dev. Never commit .env to source control.
# For EAS builds, set these in eas.json "env" blocks or via `eas secret:create`.

# ── API ───────────────────────────────────────────────────────────────────────
# The API listens on 4000 by default (`services/api/src/server.ts`), and the EAS
# `development` profile uses `http://localhost:4000`. AUDIT L2 is the record of
# three packages having disagreed on this port; 4000 is the agreed value.
#
# If your local API is on another port because `services/api/.env` sets PORT,
# either drop that override or match it here — the two have to agree.
#
#   Simulator on the same machine as the API:  http://localhost:4000
#   Physical device on the same network:       http://<your-machine-LAN-IP>:4000
#
# Leave this unset and the app falls back to http://localhost:4000, or to the
# Expo dev-server host when one can be detected.
EXPO_PUBLIC_API_URL=http://localhost:4000

# If both are set, EXPO_PUBLIC_API_BASE_URL takes precedence.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# A development build REFUSES a non-local API URL. That is deliberate: pointing
# `expo start` at a deployed API means local development reads and writes real
# customer data, which is what this file used to do by default.
#
# Set this to 1 only to do that on purpose. It warns loudly at every boot while
# it is in effect, and it is the only way past the guard in lib/api-base-url.ts.
# EXPO_PUBLIC_ALLOW_PROD_API=1

# ── Observability ─────────────────────────────────────────────────────────────
# Create a React Native project at sentry.io and paste the DSN here.
# Leave blank to disable crash reporting in dev.
#
# NOTE: app/_layout.tsx initialises Sentry with `attachScreenshot: true`, so
# supplying a DSN starts uploading screenshots of whatever is on screen —
# including site photographs. Treat it as a decision, not a switch.
EXPO_PUBLIC_SENTRY_DSN=

# ── Debug ─────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_INPUT_DEBUG=false
